{
  "expo": {
    "name": "Mesā",
    "slug": "mesa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mesa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#18293A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mesa.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Mesā syncs your meals and activity to keep your daily macros accurate.",
        "NSHealthUpdateUsageDescription": "Mesā writes logged meals to Apple Health so your nutrition stays in sync."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#18293A"
      },
      "package": "com.mesa.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18293A",
          "image": "./assets/splash.png",
          "resizeMode": "cover"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
