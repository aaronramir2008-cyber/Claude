# Mesā environment variables
# Copy this file to .env and fill in your own values.
# Anything prefixed with EXPO_PUBLIC_ is embedded in the client bundle, so only
# put publishable (anon) keys here — never service-role secrets.

# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# OpenAI key is used server-side only (Supabase Edge Function), never shipped in
# the app bundle. Set it with: supabase secrets set OPENAI_API_KEY=sk-...
